{
  "model_version": "capital-v3.2.0",
  "schema_version": 1,
  "objective": "maximize long-run after-cost geometric return subject to liquidity, concentration, forced-sale constraints and the asymmetric-growth Investment Constitution",
  "investment_constitution": {
    "version": 1,
    "authority": "FINAL_CAPITAL_ELIGIBILITY_GATE",
    "required_before_new_capital": true,
    "rules": ["earnings_power","fundamental_driven_return","catalyst","convexity","survival_downside","quarterly_falsifiability"],
    "missing_evidence_policy": "BLOCKED"
  },
  "return_comparison": {
    "comparison_basis": "ANNUALIZED_NOMINAL_PRE_TAX_AFTER_PUBLIC_FRICTION",
    "upstream_security_native_horizon_months": 15,
    "broad_equity_native_horizon_months": 12,
    "cash_native_horizon_months": 12,
    "debt_native_horizon_months": 12,
    "friction_treatment": "one_time_round_trip_cost_applied_to_terminal_value_before_annualization",
    "guardrail": "Native returns with different horizons are never compared directly. Tax and user-specific FX/costs remain browser-local."
  },
  "benchmark_models": {
    "2330": {"method":"upstream_scenario_valuation","authority":"ALPHA_ENGINE"},
    "TAIWAN_BROAD": {"method":"earnings_yield_plus_sustainable_nominal_growth","proxy":"0050","sustainable_nominal_growth_pct":4.0,"max_fact_age_days":240,"native_horizon_months":12,"authority":"MODEL_ASSUMPTION"},
    "GLOBAL_EQUITY": {"method":"earnings_yield_plus_sustainable_nominal_growth","proxy":"VT","sustainable_nominal_growth_pct":4.0,"max_fact_age_days":240,"native_horizon_months":12,"authority":"MODEL_ASSUMPTION"},
    "CASH": {"method":"cbc_discount_rate_proxy","max_fact_age_days":120,"native_horizon_months":12,"authority":"FIRST_PARTY_RATE_PROXY"},
    "DEBT_REPAYMENT": {"method":"user_effective_rate","native_horizon_months":12,"storage":"BROWSER_LOCAL_ONLY","authority":"PRIVATE_INPUT"}
  },
  "expectation_engine": {
    "authority": "ANALYTIC_ONLY",
    "scenario_pe_method": "market_implied_eps_at_base_multiple = price / base_multiple",
    "guardrail": "Expectation gap explains what the current price appears to require under the selected multiple. It cannot create or upgrade BUY."
  },
  "shadow_book": {
    "cohort": "ALL_UPSTREAM_RESEARCHED_SECURITIES_PLUS_DISCOVERY_OBSERVATIONS",
    "horizons_days": {"3m":90,"6m":180,"12m":365},
    "primary_security_kpi": "realized_opportunity_cost_alpha_vs_tsmc",
    "decision_regret_scope": "TSMC_ONLY_UNTIL_ALL_ALTERNATIVE_POINT_IN_TIME_PRICES_EXIST",
    "authority": "CALIBRATION_ONLY"
  },
  "capital_decision_journal": {
    "decision_period": "ISO_WEEK_OF_ALPHA_AS_OF",
    "primary_rule": "one primary snapshot per decision period; superseded runs remain immutable model revisions",
    "authority": "AUDIT_ONLY"
  },
  "optimizer": {
    "method":"constrained_expected_log_growth_approximation",
    "formula":"mu'w - 0.5*lambda*w'Sigma*w - frictions",
    "risk_aversion_lambda":1.25,
    "iterations":500,
    "cash_floor_pct":15,
    "single_stock_cap_pct":25,
    "new_alpha_cap_pct":12,
    "broad_equity_cap_pct":55,
    "no_shorting":true,
    "individual_stock_entry_requirement":"upstream BUY_CANDIDATE AND Investment Constitution PASS"
  },
  "ruin_model": {
    "method":"factor_stress_plus_reverse_stress_and_private_margin_inputs",
    "horizon":"12m",
    "outputs":["factor_stress_returns","stress_post_debt_ratio","forced_sale_state","liquidity_buffer_state"],
    "warning":"MODEL ESTIMATE; browser-local brokerage maintenance rules remain authoritative for personal forced-sale risk"
  },
  "calibration": {
    "primary_kpi":"realized_opportunity_cost_alpha",
    "horizons_days":{"3m":90,"6m":180,"12m":365,"18m":548},
    "attribution_dimensions":["earnings_error","multiple_error","timing_error","thesis_error"],
    "no_backfill_before_point_in_time_capture":true
  },
  "governance": {
    "decision_snapshot_requires":["model_version","code_commit","evidence_hash","reference_price","hurdle","expected_return","constitution_status"],
    "personal_data_storage":"BROWSER_LOCAL_ONLY",
    "automatic_trading":false
  }
}
